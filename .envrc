use flake

# Prefer repo wrapper over any global gqn.
PATH_add bin

# Isolate local CLI state from production ~/.config/graphnote.
export GRAPHNOTE_CONFIG_DIR="$PWD/.direnv/graphnote"
export GRAPHNOTE_URL="${GRAPHNOTE_URL:-http://127.0.0.1:5173}"

watch_file .dev.vars
if [[ -f .dev.vars ]]; then
  dotenv .dev.vars
fi
# Optional: export GRAPHNOTE_TOKEN=gqn_… for local CLI
