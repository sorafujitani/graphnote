{
  "name": "graphnote",
  "private": true,
  "description": "Personal graph notes on Cloudflare Workers (Google auth, D1, R2 export)",
  "bin": {
    "gqn": "./dist/cli/gqn.js"
  },
  "files": [
    "dist/cli",
    "cli",
    "skills"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run build:cli && tsc -b && vp build && pnpm run build:install",
    "build:cli": "tsup",
    "build:install": "tsx scripts/pack-install-assets.ts",
    "cf-typegen": "wrangler types",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run knip && pnpm run test:coverage && pnpm run build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply graphnote --local",
    "db:migrate:remote": "wrangler d1 migrations apply graphnote --remote",
    "deploy": "pnpm run db:migrate:remote && wrangler deploy",
    "dev": "pnpm run db:migrate:local && vp dev",
    "fmt": "vp fmt .",
    "fmt:check": "vp fmt --check .",
    "gqn": "tsx ./cli/gqn.ts",
    "hooks:install": "lefthook install",
    "knip": "knip",
    "lint": "vp lint .",
    "prepare": "pnpm run build:cli",
    "preview": "pnpm run build && vp preview",
    "test": "vp test run",
    "test:browser": "vp test run --project browser",
    "test:coverage": "vp test run --coverage",
    "test:node": "vp test run --project node",
    "test:setup": "playwright install chromium",
    "test:watch": "vp test",
    "typecheck": "tsc -b",
    "typecheck:cli": "tsc -p tsconfig.cli.json"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "better-auth": "^1.6.25",
    "hono": "^4.12.34",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.18.0"
}
