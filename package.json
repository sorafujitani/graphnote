{
  "name": "graphnote",
  "private": true,
  "description": "Personal graph notes on Cloudflare Workers (D1 + R2 export)",
  "bin": {
    "graphnote": "./dist/cli/graphnote.js"
  },
  "files": [
    "dist/cli",
    "cli",
    "skills"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run build:cli && tsc -b && vite build",
    "build:cli": "tsup",
    "cf-typegen": "wrangler types",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run knip && pnpm run test:coverage && pnpm run build:cli && vite build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply graphnote --local",
    "db:migrate:remote": "wrangler d1 migrations apply graphnote --remote",
    "deploy": "pnpm run db:migrate:remote && wrangler deploy",
    "dev": "pnpm run db:migrate:local && vite",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "graphnote": "tsx ./cli/graphnote.ts",
    "hooks:install": "lefthook install",
    "knip": "knip",
    "lint": "oxlint .",
    "prepare": "pnpm run build:cli",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.cli.json",
    "typecheck:cli": "tsc -p tsconfig.cli.json"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "hono": "^4.12.34",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.11.1",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsup": "^8.5.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.18.0"
}
